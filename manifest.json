{
  "manifest_version": 3,
  "name": "AFK Timer — Focus & Breaks",
  "version": "1.0.0",
  "description": "A simple focus timer with 60-minute work sessions and 10-minute breaks.",
  "permissions": [
    "alarms",
    "notifications",
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "AFK Timer",
    "default_icon": "icon-128.png",
    "default_popup": "index.html"
  },
  "icons": {
    "128": "icon-128.png"
  }
}
